# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# See docs/local-setup.md.

ALTRIUM_DB_URL=jdbc:mysql://localhost:3306/altrium?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
ALTRIUM_DB_USER=altrium
ALTRIUM_DB_PASSWORD=

# Test suite runs against real MySQL, not H2, so Flyway and DB constraints are exercised.
ALTRIUM_TEST_DB_URL=jdbc:mysql://localhost:3306/altrium_test?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Asgardeo (decided, do not substitute). The issuer is a public identifier, not a secret,
# and our tenant is already the default in application.yml. Set this only to point at a
# different tenant. See docs/asgardeo-setup.md.
ASGARDEO_ISSUER_URI=https://api.asgardeo.io/t/pasindudilshan/oauth2/token

ALTRIUM_PORT=8080
