# Overrides only. The app starts with no .env at all - see src/config.ts, which carries
# the tenant defaults so a fresh clone runs without setup, exactly as the backend commits
# its Asgardeo issuer URI in application.yml.
#
# Copy to .env (gitignored) to point at a different tenant or a backend on another host.
#
# Nothing here is a credential. A PKCE single-page application has no client secret,
# because anything shipped in a browser bundle is readable. If anyone hands you a client
# *secret* for this application, the application type in Asgardeo is wrong - see
# docs/asgardeo-setup.md.

VITE_ASGARDEO_CLIENT_ID=
VITE_ASGARDEO_BASE_URL=
VITE_API_BASE_URL=
